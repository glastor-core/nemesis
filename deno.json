{
  "name": "nemesis",
  "version": "1.4.0",
  "license": "MIT",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --env --allow-all src/main.ts",
    "scan": "deno run --env --allow-all src/main.ts --all",
    "compile": "deno compile --allow-all --output bin/nemesis src/main.ts",
    "compile:linux": "deno compile --allow-all --target x86_64-unknown-linux-gnu --output bin/nemesis-linux src/main.ts",
    "compile:windows": "deno compile --allow-all --target x86_64-pc-windows-msvc --output bin/nemesis-windows.exe src/main.ts",
    "compile:darwin": "deno compile --allow-all --target x86_64-apple-darwin --output bin/nemesis-darwin src/main.ts",
    "compile:darwin-arm": "deno compile --allow-all --target aarch64-apple-darwin --output bin/nemesis-darwin-arm64 src/main.ts",
    "check": "deno check src/main.ts",
    "test": "deno test --allow-all",
    "test:watch": "deno test --allow-all --watch",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "hooks:install": "git config core.hooksPath .githooks",
    "setup": "deno task hooks:install"
  },
  "imports": {
    "@actions/core": "npm:@actions/core@^1.11.1",
    "@actions/github": "npm:@actions/github@^6.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@std/cli": "jsr:@std/cli@^1.0.9",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.5/colors",
    "@std/fs": "jsr:@std/fs@^1.0.11",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/yaml": "jsr:@std/yaml@^1.0.5",
    "zod": "npm:zod@^3.23.8"
  },
  "compilerOptions": {
    "strict": true
  }
}
